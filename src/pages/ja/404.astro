---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { jaMessages } from "../../i18n/ja";

const nf = jaMessages.notFound;
---

<BaseLayout locale="ja" messages={jaMessages} page="404" seo={nf.seo} schemaType="WebPage" noindex>
	<article class="notfound">
		<p class="notfound-label">{nf.label}</p>
		<h1 class="notfound-title">{nf.title}</h1>
		<p class="notfound-body">{nf.body}</p>
		<a class="notfound-home" href="/ja/">{nf.homeLink}</a>
	</article>
</BaseLayout>
