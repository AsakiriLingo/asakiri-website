---
import BaseLayout from "../layouts/BaseLayout.astro";
import { enMessages } from "../i18n/en";

const nf = enMessages.notFound;
---

<BaseLayout locale="en" messages={enMessages} page="404" seo={nf.seo} schemaType="WebPage" noindex>
	<article class="notfound">
		<p class="notfound-label">{nf.label}</p>
		<h1 class="notfound-title">{nf.title}</h1>
		<p class="notfound-body">{nf.body}</p>
		<a class="notfound-home" href="/">{nf.homeLink}</a>
	</article>
</BaseLayout>
