---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { itMessages } from "../../i18n/it";

const nf = itMessages.notFound;
---

<BaseLayout locale="it" messages={itMessages} page="404" seo={nf.seo} schemaType="WebPage" noindex>
	<article class="notfound">
		<p class="notfound-label">{nf.label}</p>
		<h1 class="notfound-title">{nf.title}</h1>
		<p class="notfound-body">{nf.body}</p>
		<a class="notfound-home" href="/it/">{nf.homeLink}</a>
	</article>
</BaseLayout>
