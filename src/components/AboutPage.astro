---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { LandingMessages } from "../i18n/types";

interface Props {
  locale: "en" | "ja";
  messages: LandingMessages;
}

const { locale, messages } = Astro.props;
const { about } = messages;
---

<BaseLayout locale={locale} messages={messages} page="about" seo={about.seo} schemaType="AboutPage">
	<article class="about">
		<header class="about-head">
			<h1>{about.title}</h1>
			<p class="about-lede">{about.lede}</p>
		</header>
		<section class="about-statements">
			<div class="about-statement">
				<p class="about-statement-label">{about.missionLabel}</p>
				<p class="about-statement-body">{about.mission}</p>
			</div>
			<div class="about-statement">
				<p class="about-statement-label">{about.visionLabel}</p>
				<p class="about-statement-body">{about.vision}</p>
			</div>
		</section>
		{about.sections.map((section) => (
			<section class="about-section">
				<h2>{section.heading}</h2>
				{section.body.map((paragraph) => <p>{paragraph}</p>)}
			</section>
		))}
	</article>
</BaseLayout>
