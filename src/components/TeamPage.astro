---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { LandingMessages } from "../i18n/types";

interface Props {
  locale: "en" | "ja";
  messages: LandingMessages;
}

const { locale, messages } = Astro.props;
const { team } = messages;

const linkedinLabel = (name: string) =>
  locale === "ja" ? `${name}のLinkedIn` : `${name} on LinkedIn`;
const emailLabel = (name: string) =>
  locale === "ja" ? `${name}にメール` : `Email ${name}`;
---

<BaseLayout locale={locale} messages={messages} page="team" seo={team.seo} schemaType="AboutPage">
	<article class="team">
		<header class="team-head">
			<h1>{team.title}</h1>
			<p class="team-lede">{team.lede}</p>
		</header>
		<ul class="team-grid" role="list">
			{team.members.map((member) => (
				<li class="team-member">
					<img
						class="team-photo"
						src={member.image}
						alt={member.imageAlt}
						width="640"
						height="640"
						loading="lazy"
						decoding="async"
					/>
					<div class="team-text">
						<p class="team-name">{member.name}</p>
						<p class="team-role">{member.role}</p>
						<p class="team-bio">{member.bio}</p>
						{(member.linkedin || member.email) && (
							<p class="team-social">
								{member.linkedin && (
									<a
										href={member.linkedin}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={linkedinLabel(member.name)}
									>
										<svg class="team-social-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
											<path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
										</svg>
									</a>
								)}
								{member.email && (
									<a href={`mailto:${member.email}`} aria-label={emailLabel(member.name)}>
										<svg class="team-social-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
											<path fill="currentColor" d="M3.5 1.5H20.5A2.5 2.5 0 0 1 23 4V5L12 12.2L1 5V4A2.5 2.5 0 0 1 3.5 1.5ZM1 7.8L12 15L23 7.8V20A2.5 2.5 0 0 1 20.5 22.5H3.5A2.5 2.5 0 0 1 1 20Z" />
										</svg>
									</a>
								)}
							</p>
						)}
					</div>
				</li>
			))}
		</ul>
	</article>
</BaseLayout>
