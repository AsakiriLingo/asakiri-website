---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { LandingMessages, LegalContent } from "../i18n/types";

interface Props {
  locale: "en" | "ja";
  messages: LandingMessages;
  page: "privacy" | "terms";
  content: LegalContent;
}

const { locale, messages, page, content } = Astro.props;
---

<BaseLayout locale={locale} messages={messages} page={page} seo={content.seo} schemaType="WebPage">
	<article class="about">
		<header class="about-head">
			<h1>{content.title}</h1>
			<p class="legal-updated">{content.updated}</p>
			<p class="about-lede">{content.lede}</p>
		</header>
		{content.sections.map((section) => (
			<section class="about-section">
				<h2>{section.heading}</h2>
				{section.body.map((paragraph) => <p>{paragraph}</p>)}
			</section>
		))}
	</article>
</BaseLayout>
