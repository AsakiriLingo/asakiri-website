---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { LandingMessages, Locale } from "../i18n/types";
import { studioDownloads, partners } from "../config";

interface Props {
  locale: Locale;
  messages: LandingMessages;
}

const { locale, messages } = Astro.props;
---

<BaseLayout locale={locale} messages={messages} page="home" seo={messages.seo}>
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-heading">
			<h1 id="hero-title">{messages.title}</h1>
		</div>
		<div class="hero-note">
			<p class="hero-description">{messages.description}</p>
			<div class="hero-actions">
				<details class="download">
					<summary class="download-button" aria-label={messages.download.ariaLabel}>
						<span>{messages.download.label}</span>
						<span class="download-caret" aria-hidden="true">▾</span>
					</summary>
					<ul class="download-menu" aria-label={messages.download.menuLabel}>
						{studioDownloads.map((item) => (
							<li>
								<a href={item.url} target="_blank" rel="noopener noreferrer">
									<span>{messages.download[item.platform]}</span>
									<span class="download-format">{item.format}</span>
								</a>
							</li>
						))}
					</ul>
				</details>
			</div>
		</div>
	</section>

	<section class="partners-strip" aria-label={messages.sponsor.partners.title}>
		<p class="partners-strip-label">{messages.sponsor.partners.title}</p>
		<ul class="partners-strip-logos" role="list">
			{partners.map((partner) => (
				<li>
					<a
						href={partner.url}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={partner.name}
					>
						<img src={partner.logo} alt={partner.name} height="28" loading="lazy" />
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="showcase" aria-labelledby="showcase-title">
		<div class="showcase-intro">
			<p class="showcase-label">{messages.showcase.label}</p>
			<h2 id="showcase-title">{messages.showcase.title}</h2>
			<p class="showcase-lede">{messages.showcase.lede}</p>
		</div>
		<ul class="showcase-list" role="list">
			{messages.showcase.items.map((item) => (
				<li class="showcase-item">
					<figure class="showcase-figure">
						<img
							class="showcase-shot"
							src={item.image}
							alt={item.imageAlt}
							width="1600"
							height="878"
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<div class="showcase-text">
						<h3 class="showcase-item-title">{item.title}</h3>
						<p class="showcase-item-body">{item.body}</p>
					</div>
				</li>
			))}
		</ul>
	</section>
</BaseLayout>

<script>
	const closeMenus = (except) => {
		document.querySelectorAll("details.download[open]").forEach((menu) => {
			if (menu !== except) menu.removeAttribute("open");
		});
	};

	document.addEventListener("click", (event) => {
		const target = event.target;
		const inside = target instanceof Element ? target.closest("details.download") : null;
		closeMenus(inside);
	});

	document.addEventListener("keydown", (event) => {
		if (event.key !== "Escape") return;
		document.querySelectorAll("details.download[open]").forEach((menu) => {
			menu.removeAttribute("open");
			const summary = menu.querySelector("summary");
			if (summary instanceof HTMLElement) summary.focus();
		});
	});
</script>
