---
import "../styles/global.css";
import type { LandingMessages } from "../i18n/types";

interface Props {
  locale: "en" | "ja";
  messages: LandingMessages;
}

const { locale, messages } = Astro.props;
const githubUrl = "https://github.com/AsakiriLingo/asakiri-studio";
const discordUrl = "https://discord.gg/X2W6NX7CNY";
const homeUrl = locale === "ja" ? "/ja/" : "/";
const alternateUrl = locale === "ja" ? "/" : "/ja/";
const siteUrl = Astro.site ?? new URL("https://www.asakiri.com");
const canonicalUrl = new URL(homeUrl, siteUrl);
const englishUrl = new URL("/", siteUrl);
const japaneseUrl = new URL("/ja/", siteUrl);
const socialImage = locale === "ja"
  ? { url: new URL("/og-ja.png", siteUrl), width: "3418", height: "1740" }
  : { url: new URL("/og-image.png", siteUrl), width: "3410", height: "1732" };
const ogLocale = locale === "ja" ? "ja_JP" : "en_US";
const alternateOgLocale = locale === "ja" ? "en_US" : "ja_JP";
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: messages.brand,
  url: canonicalUrl.href,
  description: messages.seo.description,
  inLanguage: locale === "ja" ? "ja-JP" : "en-US",
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={messages.seo.description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/png" href="/app-icon.png" />
		<link rel="canonical" href={canonicalUrl.href} />
		<link rel="alternate" hreflang="en-US" href={englishUrl.href} />
		<link rel="alternate" hreflang="ja-JP" href={japaneseUrl.href} />
		<link rel="alternate" hreflang="x-default" href={englishUrl.href} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={messages.brand} />
		<meta property="og:title" content={messages.seo.title} />
		<meta property="og:description" content={messages.seo.description} />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={alternateOgLocale} />
		<meta property="og:image" content={socialImage.url.href} />
		<meta property="og:image:secure_url" content={socialImage.url.href} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content={socialImage.width} />
		<meta property="og:image:height" content={socialImage.height} />
		<meta property="og:image:alt" content={messages.seo.imageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={messages.seo.title} />
		<meta name="twitter:description" content={messages.seo.description} />
		<meta name="twitter:image" content={socialImage.url.href} />
		<meta name="twitter:image:alt" content={messages.seo.imageAlt} />

		<script type="application/ld+json" set:html={structuredData} />
		<title>{messages.seo.title}</title>
	</head>
	<body>
		<div class="site-shell">
			<header class="site-header">
				<a class="brand" href={homeUrl} aria-label={messages.brand}>
					<img class="brand-mark" src="/app-icon.png" alt="" width="36" height="36" />
					<span>{messages.brand}</span>
				</a>
				<nav class="site-nav" aria-label={messages.navigationLabel}>
					<a class="language-link" href={alternateUrl}>{messages.alternateLocaleName}</a>
					<a class="header-community-link" href={discordUrl} target="_blank" rel="noopener noreferrer">
						Discord <span aria-hidden="true">↗</span>
					</a>
					<a class="header-community-link" href={githubUrl} target="_blank" rel="noopener noreferrer">
						GitHub <span aria-hidden="true">↗</span>
					</a>
				</nav>
			</header>

			<main>
				<section class="hero" aria-labelledby="hero-title">
					<div class="hero-content">
						<p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>{messages.eyebrow}</p>
						<h1 id="hero-title">{messages.title}</h1>
						<p class="hero-description">{messages.description}</p>
						<div class="hero-actions">
							<span class="status"><span class="status-dot" aria-hidden="true"></span>{messages.comingSoon}</span>
							<a class="discord-button" href={discordUrl} target="_blank" rel="noopener noreferrer" aria-label={messages.discordAriaLabel}>
								{messages.discordLink} <span aria-hidden="true">↗</span>
							</a>
							<a class="github-button" href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label={messages.githubAriaLabel}>
								{messages.githubLink} <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</section>
			</main>

			<footer class="site-footer">
				<span>{messages.footer}</span>
				<span>© {new Date().getFullYear()} {messages.brand}</span>
			</footer>
		</div>
	</body>
</html>
