---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { LandingMessages } from "../i18n/types";
import { githubUrl } from "../config";

interface Props {
  locale: "en" | "ja";
  messages: LandingMessages;
}

const { locale, messages } = Astro.props;
---

<BaseLayout locale={locale} messages={messages} page="home" seo={messages.seo}>
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-heading">
			<h1 id="hero-title">{messages.title}</h1>
		</div>
		<div class="hero-note">
			<p class="hero-description">{messages.description}</p>
			<div class="hero-actions">
				<span class="status"><span class="status-dot" aria-hidden="true"></span>{messages.comingSoon}</span>
				<a class="github-button" href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label={messages.githubAriaLabel}>
					{messages.githubLink} <span aria-hidden="true">↗</span>
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
