---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { LandingMessages, Locale } from "../i18n/types";
import { partners } from "../config";

interface Props {
  locale: Locale;
  messages: LandingMessages;
}

const { locale, messages } = Astro.props;
const { sponsor } = messages;
---

<BaseLayout locale={locale} messages={messages} page="sponsor" seo={sponsor.seo} schemaType="WebPage">
	<article class="sponsor">
		<p class="sponsor-label">{sponsor.label}</p>
		<h1 class="sponsor-title">{sponsor.partners.title}</h1>
		<p class="sponsor-body">{sponsor.partners.body}</p>
		<ul class="partner-grid" role="list">
			{partners.map((partner) => (
				<li>
					<a
						class="partner-logo"
						href={partner.url}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={partner.name}
					>
						<img src={partner.logo} alt={partner.name} height="32" loading="lazy" />
					</a>
				</li>
			))}
		</ul>
	</article>
</BaseLayout>

<style>
	.partner-grid {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-xl) var(--space-2xl);
		margin-block-start: var(--space-xl);
		padding: 0;
		list-style: none;
	}

	.partner-logo {
		display: block;
	}

	.partner-logo img {
		display: block;
		width: auto;
		height: 2rem;
	}
</style>
