---
import "../styles/global.css";
import type { LandingMessages } from "../i18n/types";
import { githubUrl, discordUrl, patreonUrl, linkedinUrl } from "../config";

interface Props {
  locale: "en" | "ja";
  messages: LandingMessages;
  page: "home" | "about" | "mission" | "vision" | "team" | "sponsor" | "privacy" | "terms";
  seo: { title: string; description: string };
  schemaType?: string;
}

const { locale, messages, page, seo, schemaType = "WebSite" } = Astro.props;

const paths = {
  home: { en: "/", ja: "/ja/" },
  about: { en: "/about/", ja: "/ja/about/" },
  mission: { en: "/mission/", ja: "/ja/mission/" },
  vision: { en: "/vision/", ja: "/ja/vision/" },
  team: { en: "/team/", ja: "/ja/team/" },
  sponsor: { en: "/sponsor/", ja: "/ja/sponsor/" },
  privacy: { en: "/privacy/", ja: "/ja/privacy/" },
  terms: { en: "/terms/", ja: "/ja/terms/" },
} as const;

const homeUrl = locale === "ja" ? "/ja/" : "/";
const aboutUrl = paths.about[locale];
const missionUrl = paths.mission[locale];
const visionUrl = paths.vision[locale];
const teamUrl = paths.team[locale];
const sponsorUrl = paths.sponsor[locale];
const privacyUrl = paths.privacy[locale];
const termsUrl = paths.terms[locale];
const alternateLocale = locale === "ja" ? "en" : "ja";
const alternateUrl = paths[page][alternateLocale];

const siteUrl = Astro.site ?? new URL("https://www.asakiri.com");
const canonicalUrl = new URL(paths[page][locale], siteUrl);
const englishUrl = new URL(paths[page].en, siteUrl);
const japaneseUrl = new URL(paths[page].ja, siteUrl);

const socialImage = locale === "ja"
  ? { url: new URL("/og-ja.png", siteUrl), width: "2400", height: "1260" }
  : { url: new URL("/og-image.png", siteUrl), width: "2400", height: "1260" };
const ogLocale = locale === "ja" ? "ja_JP" : "en_US";
const alternateOgLocale = locale === "ja" ? "en_US" : "ja_JP";

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": schemaType,
  name: messages.brand,
  url: canonicalUrl.href,
  description: seo.description,
  inLanguage: locale === "ja" ? "ja-JP" : "en-US",
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={seo.description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/png" sizes="32x32" href="/app-icon-32.png" />
		<link rel="canonical" href={canonicalUrl.href} />
		<link rel="alternate" hreflang="en-US" href={englishUrl.href} />
		<link rel="alternate" hreflang="ja-JP" href={japaneseUrl.href} />
		<link rel="alternate" hreflang="x-default" href={englishUrl.href} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={messages.brand} />
		<meta property="og:title" content={seo.title} />
		<meta property="og:description" content={seo.description} />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={alternateOgLocale} />
		<meta property="og:image" content={socialImage.url.href} />
		<meta property="og:image:secure_url" content={socialImage.url.href} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content={socialImage.width} />
		<meta property="og:image:height" content={socialImage.height} />
		<meta property="og:image:alt" content={messages.seo.imageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={seo.title} />
		<meta name="twitter:description" content={seo.description} />
		<meta name="twitter:image" content={socialImage.url.href} />
		<meta name="twitter:image:alt" content={messages.seo.imageAlt} />

		<script type="application/ld+json" set:html={structuredData} />
		<title>{seo.title}</title>
	</head>
	<body>
		<div class="site-shell">
			<header class="site-header">
				<a class="brand" href={homeUrl} aria-label={messages.brand}>
					<img
						class="brand-mark"
						src="/app-icon-36.png"
						srcset="/app-icon-36.png 1x, /app-icon-72.png 2x"
						alt=""
						width="36"
						height="36"
					/>
					<span>{messages.brand}</span>
				</a>
				<nav class="site-nav" aria-label={messages.navigationLabel}>
					<a
						class="nav-link"
						href={aboutUrl}
						aria-current={page === "about" ? "page" : undefined}
					>{messages.aboutLink}</a>
					<a
						class="nav-link"
						href={missionUrl}
						aria-current={page === "mission" ? "page" : undefined}
					>{messages.mission.label}</a>
					<a
						class="nav-link"
						href={visionUrl}
						aria-current={page === "vision" ? "page" : undefined}
					>{messages.vision.label}</a>
					<a class="language-link" href={alternateUrl}>{messages.alternateLocaleName}</a>
				</nav>
			</header>

			<main>
				<slot />
			</main>

			<footer class="site-footer">
				<div class="footer-mast">
					<p class="footer-wordmark">{messages.brand}</p>
					<p class="footer-tagline">{messages.footer}</p>
				</div>
				<div class="footer-nav">
					<nav class="footer-links" aria-label={messages.siteLinksLabel}>
						<a href={teamUrl} aria-current={page === "team" ? "page" : undefined}>{messages.teamLink}</a>
						<a href={sponsorUrl} aria-current={page === "sponsor" ? "page" : undefined}>{messages.sponsorLink}</a>
					</nav>
					<nav class="footer-links" aria-label={messages.communityLabel}>
						<a href={discordUrl} target="_blank" rel="noopener noreferrer">Discord <span aria-hidden="true">↗</span></a>
						<a href={patreonUrl} target="_blank" rel="noopener noreferrer">Patreon <span aria-hidden="true">↗</span></a>
						<a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
						<a href={linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
					</nav>
				</div>
				<div class="footer-baseline">
					<p class="footer-copyright">© {new Date().getFullYear()} {messages.brand}</p>
					<nav class="footer-links footer-legal" aria-label={messages.legalLabel}>
						<a href={privacyUrl} aria-current={page === "privacy" ? "page" : undefined}>{messages.privacyLink}</a>
						<a href={termsUrl} aria-current={page === "terms" ? "page" : undefined}>{messages.termsLink}</a>
					</nav>
				</div>
			</footer>
		</div>
	</body>
</html>
