---
import "../styles/global.css";
import ChevronDown from "../components/ChevronDown.astro";
import type { LandingMessages, Locale } from "../i18n/types";
import { githubUrl, docsUrl, discordUrl, patreonUrl, linkedinUrl, partners } from "../config";

interface Props {
  locale: Locale;
  messages: LandingMessages;
  page: "home" | "about" | "how-it-works" | "mission" | "vision" | "team" | "funding" | "sponsor" | "contact" | "brand" | "privacy" | "terms" | "404";
  seo: { title: string; description: string };
  schemaType?: string;
  noindex?: boolean;
}

const { locale, messages, page, seo, schemaType = "WebSite", noindex = false } = Astro.props;

const LOCALES = ["en", "ja", "es", "it", "pt"] as const satisfies readonly Locale[];
const LOCALE_NAMES: Record<Locale, string> = {
  en: "English",
  ja: "日本語",
  es: "Español",
  it: "Italiano",
  pt: "Português",
};
const BCP47: Record<Locale, string> = {
  en: "en-US",
  ja: "ja-JP",
  es: "es-ES",
  it: "it-IT",
  pt: "pt-PT",
};
const OG_LOCALE: Record<Locale, string> = {
  en: "en_US",
  ja: "ja_JP",
  es: "es_ES",
  it: "it_IT",
  pt: "pt_PT",
};
const LANGUAGE_MENU_LABEL: Record<Locale, string> = {
  en: "Language",
  ja: "言語",
  es: "Idioma",
  it: "Lingua",
  pt: "Idioma",
};

const basePaths = {
  home: "/",
  about: "/about/",
  "how-it-works": "/how-it-works/",
  mission: "/mission/",
  vision: "/vision/",
  team: "/team/",
  funding: "/funding/",
  sponsor: "/sponsor/",
  contact: "/contact/",
  brand: "/brand/",
  privacy: "/privacy/",
  terms: "/terms/",
} as const;
type PageKey = keyof typeof basePaths;

const localizedPath = (key: PageKey, loc: Locale) =>
  loc === "en" ? basePaths[key] : `/${loc}${basePaths[key]}`;

const pageKey: PageKey = page in basePaths ? (page as PageKey) : "home";

const homeUrl = localizedPath("home", locale);
const aboutUrl = localizedPath("about", locale);
const howItWorksUrl = localizedPath("how-it-works", locale);
const missionUrl = localizedPath("mission", locale);
const visionUrl = localizedPath("vision", locale);
const teamUrl = localizedPath("team", locale);
const fundingUrl = localizedPath("funding", locale);
const sponsorUrl = localizedPath("sponsor", locale);
const contactUrl = localizedPath("contact", locale);
const brandUrl = localizedPath("brand", locale);
const privacyUrl = localizedPath("privacy", locale);
const termsUrl = localizedPath("terms", locale);

const siteUrl = Astro.site ?? new URL("https://www.asakiri.com");
const canonicalUrl = new URL(localizedPath(pageKey, locale), siteUrl);
const englishUrl = new URL(localizedPath(pageKey, "en"), siteUrl);
const localeAlternates = LOCALES.map((loc) => ({
  locale: loc,
  hreflang: BCP47[loc],
  href: new URL(localizedPath(pageKey, loc), siteUrl).href,
}));

const socialImage = locale === "ja"
  ? { url: new URL("/og-ja.png", siteUrl), width: "2400", height: "1260" }
  : { url: new URL("/og-image.png", siteUrl), width: "2400", height: "1260" };

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": schemaType,
  name: messages.brand,
  url: canonicalUrl.href,
  description: seo.description,
  inLanguage: BCP47[locale],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={seo.description} />
		<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/png" sizes="32x32" href="/app-icon-32.png" />
		{!noindex && (
			<>
				<link rel="canonical" href={canonicalUrl.href} />
				{localeAlternates.map((alt) => (
					<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
				))}
				<link rel="alternate" hreflang="x-default" href={englishUrl.href} />
			</>
		)}
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={messages.brand} />
		<meta property="og:title" content={seo.title} />
		<meta property="og:description" content={seo.description} />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:locale" content={OG_LOCALE[locale]} />
		{LOCALES.filter((loc) => loc !== locale).map((loc) => (
			<meta property="og:locale:alternate" content={OG_LOCALE[loc]} />
		))}
		<meta property="og:image" content={socialImage.url.href} />
		<meta property="og:image:secure_url" content={socialImage.url.href} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content={socialImage.width} />
		<meta property="og:image:height" content={socialImage.height} />
		<meta property="og:image:alt" content={messages.seo.imageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={seo.title} />
		<meta name="twitter:description" content={seo.description} />
		<meta name="twitter:image" content={socialImage.url.href} />
		<meta name="twitter:image:alt" content={messages.seo.imageAlt} />

		<script type="application/ld+json" set:html={structuredData} />
		<title>{seo.title}</title>
	</head>
	<body>
		<div class="site-shell">
			<header class="site-header">
				<a class="brand" href={homeUrl} aria-label={messages.brand}>
					<img
						class="brand-mark"
						src="/asakiri-mark.svg"
						alt=""
						width="36"
						height="36"
					/>
					<span>
						{messages.brandRubyText ? (
							<ruby>{messages.brandRubyBase}<rt>{messages.brandRubyText}</rt></ruby>
						) : messages.brand}
					</span>
				</a>
				<nav class="site-nav" aria-label={messages.navigationLabel}>
					<a
						class="nav-link"
						href={aboutUrl}
						aria-current={page === "about" ? "page" : undefined}
					>{messages.aboutLink}</a>
					<a
						class="nav-link"
						href={howItWorksUrl}
						aria-current={page === "how-it-works" ? "page" : undefined}
					>{messages.howItWorksLink}</a>
					<a
						class="nav-link"
						href={missionUrl}
						aria-current={page === "mission" ? "page" : undefined}
					>{messages.mission.label}</a>
					<a
						class="nav-link"
						href={visionUrl}
						aria-current={page === "vision" ? "page" : undefined}
					>{messages.vision.label}</a>
					<a
						class="nav-link"
						href={githubUrl}
						target="_blank"
						rel="noopener noreferrer"
					>GitHub <span aria-hidden="true">↗</span></a>
					<details class="language">
						<summary class="language-button" aria-label={LANGUAGE_MENU_LABEL[locale]}>
							<span>{LOCALE_NAMES[locale]}</span>
							<ChevronDown class="language-caret" size={14} />
						</summary>
						<ul class="language-menu">
							{LOCALES.map((loc) => (
								<li>
									<a
										href={localizedPath(pageKey, loc)}
										hreflang={BCP47[loc]}
										lang={loc}
										aria-current={loc === locale ? "true" : undefined}
									>{LOCALE_NAMES[loc]}</a>
								</li>
							))}
						</ul>
					</details>
				</nav>
			</header>

			<main>
				<slot />
			</main>

			<footer class="site-footer">
				<div class="footer-mast">
					<p class="footer-wordmark">
						{messages.brandRubyText ? (
							<ruby>{messages.brandRubyBase}<rt>{messages.brandRubyText}</rt></ruby>
						) : messages.brand}
					</p>
					<p class="footer-tagline">{messages.footer}</p>
					<div class="footer-partners">
						<p class="footer-partners-label">{messages.sponsor.partners.title}</p>
						<ul class="footer-partners-logos" role="list">
							{partners.map((partner) => (
								<li>
									<a
										href={partner.url}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={partner.name}
									>
										<img src={partner.logo} alt={partner.name} height="24" loading="lazy" />
									</a>
								</li>
							))}
						</ul>
					</div>
				</div>
				<div class="footer-columns">
					<nav class="footer-col" aria-labelledby="footer-explore-title">
						<h2 class="footer-col-title" id="footer-explore-title">{messages.footerExploreTitle}</h2>
						<ul class="footer-links" role="list">
							<li><a href={howItWorksUrl} aria-current={page === "how-it-works" ? "page" : undefined}>{messages.howItWorksLink}</a></li>
							<li><a href={teamUrl} aria-current={page === "team" ? "page" : undefined}>{messages.teamLink}</a></li>
							<li><a href={fundingUrl} aria-current={page === "funding" ? "page" : undefined}>{messages.fundingLink}</a></li>
							<li><a href={sponsorUrl} aria-current={page === "sponsor" ? "page" : undefined}>{messages.sponsorLink}</a></li>
							<li><a href={contactUrl} aria-current={page === "contact" ? "page" : undefined}>{messages.contactLink}</a></li>
							<li><a href={brandUrl} aria-current={page === "brand" ? "page" : undefined}>{messages.brandLink}</a></li>
						</ul>
					</nav>
					<nav class="footer-col" aria-labelledby="footer-community-title">
						<h2 class="footer-col-title" id="footer-community-title">{messages.footerCommunityTitle}</h2>
						<ul class="footer-links" role="list">
							<li><a href={discordUrl} target="_blank" rel="noopener noreferrer">Discord <span aria-hidden="true">↗</span></a></li>
							<li><a href={patreonUrl} target="_blank" rel="noopener noreferrer">Patreon <span aria-hidden="true">↗</span></a></li>
							<li><a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></li>
							<li><a href={docsUrl} target="_blank" rel="noopener noreferrer">{messages.docsLink} <span aria-hidden="true">↗</span></a></li>
							<li><a href={linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a></li>
						</ul>
					</nav>
					<nav class="footer-col" aria-labelledby="footer-legal-title">
						<h2 class="footer-col-title" id="footer-legal-title">{messages.legalLabel}</h2>
						<ul class="footer-links footer-links--single" role="list">
							<li><a href={privacyUrl} aria-current={page === "privacy" ? "page" : undefined}>{messages.privacyLink}</a></li>
							<li><a href={termsUrl} aria-current={page === "terms" ? "page" : undefined}>{messages.termsLink}</a></li>
						</ul>
					</nav>
				</div>
				<div class="footer-baseline">
					<p class="footer-copyright">© {new Date().getFullYear()} {messages.brand}</p>
				</div>
			</footer>
		</div>
		<script>
			const closeLanguageMenus = (except: Element | null) => {
				document.querySelectorAll("details.language[open]").forEach((menu) => {
					if (menu !== except) menu.removeAttribute("open");
				});
			};

			document.addEventListener("click", (event) => {
				const target = event.target;
				const inside = target instanceof Element ? target.closest("details.language") : null;
				closeLanguageMenus(inside);
			});

			document.addEventListener("keydown", (event) => {
				if (event.key !== "Escape") return;
				document.querySelectorAll("details.language[open]").forEach((menu) => {
					menu.removeAttribute("open");
					const summary = menu.querySelector("summary");
					if (summary instanceof HTMLElement) summary.focus();
				});
			});
		</script>
	</body>
</html>
